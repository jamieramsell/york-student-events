# ─────────────────────────────────────────────────────────────────────────────
# Local development environment for york-student-events (M5 — Persistence Layer).
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is gitignored; the values below are placeholders safe for local
# development only.
#
# Both services share ONE PostgreSQL instance with clear table ownership.
# See docs/adr/0002-database-technology.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres container (consumed by docker-compose.db.yml) ---
POSTGRES_USER=yse
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=york_student_events
POSTGRES_PORT=5432

# --- Shared connection details (host/port for clients of the DB above) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=york_student_events
DB_USERNAME=yse
DB_PASSWORD=change_me_in_local_env

# --- event-service (Spring Data JPA / JDBC) — used in issue #88 ---
# Spring reads these via property placeholders, e.g. spring.datasource.url=${DB_URL}
DB_URL=jdbc:postgresql://localhost:5432/york_student_events

# --- api-core (SQLAlchemy + psycopg) — used in issue #95 ---
DATABASE_URL=postgresql+psycopg://yse:change_me_in_local_env@localhost:5432/york_student_events
